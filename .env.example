# Laravel API (api.mallsize). Must share the parent domain with this app
# for Sanctum cookie auth (e.g. localhost:3000 ↔ localhost:8080), and this
# app's host:port must be in the API's SANCTUM_STATEFUL_DOMAINS.
NUXT_PUBLIC_SANCTUM_BASE_URL=http://localhost:8080
# nuxt-auth-sanctum also reads a private copy on the server (SSR requests).
NUXT_SANCTUM_BASE_URL=http://localhost:8080
NUXT_PUBLIC_API_BASE=http://localhost:8080
